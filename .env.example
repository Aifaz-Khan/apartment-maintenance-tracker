# Spring Boot Application Settings
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/maintenance_tracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security & JWT (HMAC-SHA256 secret >= 32 chars)
JWT_SECRET=super-secret-jwt-signing-key-for-maintenance-tracker-app-32chars
JWT_EXPIRATION_SECONDS=86400
SUPERADMIN_BOOTSTRAP_ENABLED=true
SUPERADMIN_EMAIL=superadmin@maintenancetracker.com
SUPERADMIN_PASSWORD=Admin@12345

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload / Local Storage Settings
ATTACHMENT_STORAGE_PATH=./var/private-attachments
IMAGE_MAX_FILE_SIZE_BYTES=5242880
AUDIO_MAX_FILE_SIZE_BYTES=10485760
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=11MB

# Mail Configuration
EMAIL_NOTIFICATIONS_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_FROM=noreply@maintenancetracker.com

# Frontend Vite Configuration
VITE_API_BASE_URL=/api/v1
