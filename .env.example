# Spring Boot Application Settings
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/maintenance_tracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security & JWT (HMAC-SHA256 secret >= 32 chars)
JWT_SECRET=super-secret-jwt-signing-key-for-maintenance-tracker-app-32chars
JWT_EXPIRATION_SECONDS=86400

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload / Local Storage Settings
FILE_STORAGE_LOCATION=./uploads
MAX_FILE_SIZE=10MB

# Mail Configuration
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@maintenancetracker.com

# Frontend Vite Configuration
VITE_API_BASE_URL=/api/v1
